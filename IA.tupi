# IA.tupi — Integração com OpenRouter
importe Servidor

var API_KEY = "vazio"
var MODELO = "openrouter/free"

funcao configurar(chave)
    API_KEY = chave
    retorna "Configurado"
fim

funcao escolher_modelo(nome)
    MODELO = nome
    retorna "Modelo: " .. nome
fim

funcao perguntar(texto)
    var corpo = "{\"model\": \"" .. MODELO .. "\",\"messages\": [{\"role\": \"user\", \"content\": \"" .. texto .. "\"}]}"
    
    # Headers simples (sem mapa — bug do parser)
    var auth = "Bearer " .. API_KEY
    
    retorna Servidor.post_simples("https://openrouter.ai/api/v1/chat/completions", corpo, auth)
fim
