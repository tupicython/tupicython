<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Saída"
        android:textColor="@color/verde_tupi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <ScrollView
        android:id="@+id/scroll_saida"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/fundo_saida"
        android:padding="8dp">

        <TextView
            android:id="@+id/texto_saida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/botao_limpar_saida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🗨 Limpar"
            android:textColor="@color/branco"
            android:background="@drawable/botao_cinza" />

        <Button
            android:id="@+id/botao_fechar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✖ Fechar"
            android:textColor="@color/branco"
            android:background="@drawable/botao_azul" />

    </LinearLayout>

</LinearLayout>
